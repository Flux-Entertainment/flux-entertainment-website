          <a href="/customised-productions">Customised Productions</a>
        </div>
      </div>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="https://www.instagram.com/flux_entertainment" target="_blank" rel="noopener" class="ig-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/></svg>
        <span class="mono">@flux_entertainment</span>
      </a>
      <a href="/contact" class="nav-cta">Book Now</a>
    </nav>
  </div>
</header>
<slot />
<div class="sister-band">
  <a href="https://www.fluxsfx.com.au" target="_blank" rel="noopener">
    <img class="sfx-logo" src="/images/a296d7dd2c0e4753.png" alt="Flux SFX">
    <span class="sister-copy">Need fireworks or special effects too? <strong>Flux SFX</strong>, our sister company, delivers that side of the show, visit fluxsfx.com.au</span>
  </a>
</div>

<footer>
  <div class="wrap">
    <div class="footer-top">
      <div>
        <img class="footer-logo" src="/images/0dd428d998516428.png" alt="Flux Entertainment">
        <p class="footer-tag">Australia's leading fire &amp; pyrotechnics performance company. Professional, safe, unforgettable, every time.</p>
      </div>
      <div class="footer-cols">
        <div class="footer-col">
          <span class="mono">Entertainment</span>
          <a href="/pyrotechnics-performers">Pyrotechnics Performers</a>
          <a href="/fire-shows-acts">Fire Shows &amp; Acts</a>
          <a href="/angle-grinding-performers">Angle Grinding</a>
          <a href="/led-pixel-shows">LED / Pixel Shows</a>
          <a href="/whip-cracking">Whip Cracking</a>
          <a href="/customised-productions">Customised Productions</a>
        </div>
        <div class="footer-col">
          <span class="mono">Studio</span>
          <a href="/about">About</a>
          <a href="#contact">Contact</a>
          <a href="#contact">Book Now</a>
        </div>
        <div class="footer-col">
          <span class="mono">Connect</span>
          <a href="https://www.instagram.com/flux_entertainment" target="_blank" rel="noopener">Instagram</a>
          <a href="https://www.facebook.com/fluxentertainment.pyrotechnics/" target="_blank" rel="noopener">Facebook</a>
          <a href="https://www.youtube.com/channel/UCt079qpp2QLodEhTrJIeBGg" target="_blank" rel="noopener">YouTube</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2026 Flux Productions Australia Pty Ltd. ABN 68 720 814 599.</span>
    </div>
  </div>
</footer>

<script>
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('siteNav');
  toggle.addEventListener('click', () => nav.classList.toggle('open'));
  document.querySelectorAll('nav a').forEach(a => a.addEventListener('click', (e) => {
    if (a.closest('.dropdown-trigger')) return; // handled separately below
    nav.classList.remove('open');
  }));

  // Mobile: tap "Entertainment" label to expand/collapse the dropdown instead of navigating
  const entDropdown = document.getElementById('entDropdown');
  const entTrigger = entDropdown.querySelector('.dropdown-trigger');
  entTrigger.addEventListener('click', (e) => {
    if (window.matchMedia('(max-width:860px)').matches) {
      e.preventDefault();
      entDropdown.classList.toggle('mobile-open');
    }
  });
  entDropdown.querySelectorAll('.dropdown-menu a').forEach(a => a.addEventListener('click', () => nav.classList.remove('open')));


  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if(window.scrollY > 40){ header.style.background = 'rgba(10,9,8,0.92)'; }
    else { header.style.background = 'linear-gradient(to bottom, rgba(10,9,8,0.92), rgba(10,9,8,0))'; }
  });

  // ember particles
  const hero = document.querySelector('.hero');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(hero && !prefersReduced){
    for(let i=0;i<22;i++){
      const e = document.createElement('div');
      e.className = 'ember';
      e.style.left = Math.random()*100 + '%';
      e.style.animationDuration = (8 + Math.random()*10) + 's';
      e.style.animationDelay = (Math.random()*10) + 's';
      e.style.width = e.style.height = (2 + Math.random()*4) + 'px';
      hero.appendChild(e);
    }
  }
</script>

<script src="https://unpkg.com/lenis@1.3.26/dist/lenis.min.js"></script>
<script>
  // Smooth scroll (skipped entirely if the visitor prefers reduced motion)
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && window.Lenis) {
    new Lenis({ autoRaf: true, anchors: true });
  }

  // Auto-reveal content as it scrolls into view (skips anything in the first-viewport hero)
  (function(){
    var selectors = '.section-head, .svc-photo, .option-item, .highlight-block, .sfx-callout, .service-row, .video-card, .event-item, .license-item, .form-field, .testimonial';
    var targets = document.querySelectorAll(selectors);
    targets.forEach(function(el){
      if (el.closest('.hero, .svc-hero')) return; // don't hide above-the-fold content
      el.classList.add('reveal');
    });
    var observer = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(function(el){ observer.observe(el); });
  })();
</script>
</body>
</html>
