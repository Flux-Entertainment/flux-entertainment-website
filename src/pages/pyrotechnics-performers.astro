---
import Layout from '../layouts/Layout.astro';
const title = "Pyrotechnics Performers | Flux Entertainment";
const description = "Australia's only firework-dance performers at this scale — independently licensed nationwide. Solo to full ensemble shows, custom-built for stadiums, TV, and major events.";
---
<Layout title={title} description={description}>
  <Fragment slot="page-style">
<style is:global>
  .svc-hero{
    position:relative; min-height:60vh; padding-top:140px; padding-bottom:60px; overflow:hidden;
    background:var(--void);
  }
  .svc-hero-video{position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center center; z-index:0;}
  .svc-hero-overlay{
    position:absolute; inset:0; z-index:1;
    background:
      linear-gradient(to top, rgba(10,9,8,0.97) 0%, rgba(10,9,8,0.65) 55%, rgba(10,9,8,0.45) 100%),
      radial-gradient(ellipse 70% 60% at 75% 25%, rgba(140,26,26,0.35) 0%, rgba(10,9,8,0) 65%);
  }
  .svc-hero h1{font-size:clamp(2.6rem, 6vw, 5rem); color:var(--bone); max-width:820px;}
  .svc-breadcrumb{color:var(--ash-dim); font-size:0.82rem; margin-bottom:20px;}
  .svc-breadcrumb a{color:var(--ash-dim);}
  .svc-breadcrumb a:hover{color:var(--gold);}

  .svc-photo{
    aspect-ratio:3/4; background:
      radial-gradient(circle at 30% 20%, rgba(214,40,40,0.35), transparent 60%), var(--char-2);
    border:1px solid #2A231F;
  }
  .options-grid{display:grid; grid-template-columns:1fr; gap:0; position:relative; z-index:2; margin-top:26px; max-width:640px;}
  .option-item{display:flex; align-items:center; gap:14px; padding:14px 0; border-top:1px solid #29221E; color:var(--ash); font-size:0.98rem;}
  .option-item svg{width:18px; height:18px; color:var(--gold); flex-shrink:0;}

  .photo-row{display:grid; grid-template-columns:repeat(3,1fr); gap:20px; position:relative; z-index:2;}
  .photo-row .svc-photo{aspect-ratio:4/3;}

  .highlight-block{
    border-left:2px solid var(--flame); padding:6px 0 6px 28px; margin-top:50px;
    position:relative; z-index:2;
  }
  .highlight-block p{color:var(--ash); font-size:1.05rem; line-height:1.6;}

  .sfx-callout{
    margin-top:50px; border:1px solid #2A231F; padding:32px; display:flex; align-items:center;
    justify-content:space-between; gap:24px; flex-wrap:wrap; position:relative; z-index:2;
  }
  .sfx-callout p{color:var(--ash); max-width:560px; font-size:0.98rem;}
  .sfx-callout p strong{color:var(--bone);}

  @media (max-width:860px){
    .options-grid{grid-template-columns:1fr;}
    .photo-row{grid-template-columns:1fr 1fr;}
    .about-grid{grid-template-columns:1fr;}
  }
</style>
  </Fragment>
<main id="top">

  <!-- SERVICE HERO -->
  <section class="svc-hero">
    <video class="svc-hero-video" autoplay muted loop playsinline aria-label="Flux Entertainment pyrotechnics performers dancing with fireworks">
      <source src="https://videos.fluxentertainment.com.au/dragonloop-hero.mp4" type="video/mp4">
    </video>
    <div class="svc-hero-overlay"></div>
    <div class="mark-bg" style="top:-150px; right:-200px; opacity:0.3; z-index:1;"></div>
    <div class="wrap" style="position:relative; z-index:2;">
      <div class="svc-breadcrumb"><a href="/">Home</a> / <a href="/#services">Entertainment</a> / Pyrotechnics Performers</div>
      <span class="mono eyebrow">Entertainment</span>
      <h1 style="margin-top:18px;">Pyrotechnics Performers</h1>
      <p class="hero-sub" style="margin-top:22px;">Dancing with fireworks — it's what Flux is renowned for, and our signature style is truly one-of-a-kind.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn-primary">Book Now</a>
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="about" style="padding-top:70px;">
    <div class="mark-bg" style="top:10%; left:-350px; opacity:0.25;"></div>
    <div class="wrap about-grid">
      <div class="about-copy">
        <p>We are Australia's only performers delivering firework-dance shows at this scale, and the only team independently licensed to do so nationwide — allowing us to perform in every state with complete freedom and compliance.</p>
        <p>Our firework-dance acts are intensely bright, highly impactful, and precisely choreographed. Available as solo features through to full ensembles, each show is customised to suit your event and features an array of specialised pyro props, unique acts, and diverse pyrotechnic effects.</p>
        <p>Looking for the excitement of handheld fireworks, but working within a tighter budget? Ask us about adding a handheld pyrotechnic finale to one of our high-impact fire shows.</p>
        <a href="/contact" class="btn-ghost" style="display:inline-block; margin-top:10px;">Enquire About This Show</a>
      </div>
      <div class="svc-photo" style="overflow:hidden;">
        <video autoplay muted loop playsinline aria-label="Flux Entertainment pyrotechnics performance close-up" style="width:100%; height:100%; object-fit:cover;">
          <source src="https://videos.fluxentertainment.com.au/pyro-hero-original.mp4" type="video/mp4">
        </video>
      </div>
    </div>
  </section>

  <!-- AVAILABLE OPTIONS -->
  <section class="provide" style="padding-top:60px; background:
      linear-gradient(to bottom, rgba(10,9,8,0.6) 0%, rgba(10,9,8,0.92) 70%, var(--void) 100%),
      url('/images/083b6cae664aebd3.jpg');
      background-size:cover; background-position:center; background-repeat:no-repeat;">
    <div class="wrap">
      <div class="section-head">
        <span class="mono eyebrow">What's Included</span>
        <h2 style="margin-top:18px;">Available Options</h2>
      </div>
      <div class="options-grid">
        <div class="option-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Solo feature firework-dancing shows</div>
        <div class="option-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Duo feature firework-dancing shows</div>
        <div class="option-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Large group feature firework-dancing shows</div>
        <div class="option-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Hybrid pyrotechnics with fire shows</div>
        <div class="option-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Exclusive Flux pyrotechnic props</div>
        <div class="option-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Long-duration pyrotechnic effects and shows</div>
        <div class="option-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Suitable for indoor and outdoor environments</div>
      </div>
    </div>
  </section>

  <!-- PHOTO ROW -->
  <section class="services" style="padding-top:70px; padding-bottom:70px;">
    <div class="wrap">
      <div class="photo-row" style="margin-bottom:20px;">
        <div class="svc-photo" style="overflow:hidden;"><img src="/images/73892fc131e8968f.jpg" alt="Flux Entertainment pyrotechnics performer with handheld fireworks" style="width:100%; height:100%; object-fit:cover;"></div>
        <div class="svc-photo" style="overflow:hidden;"><img src="/images/971da3c7eff3a3dc.jpg" alt="Flux Entertainment performer with pyrotechnic wings" style="width:100%; height:100%; object-fit:cover;"></div>
        <div class="svc-photo" style="overflow:hidden;"><img src="/images/83eeddad6793dabb.jpg" alt="Flux Entertainment pyrotechnics performer at a V8 Supercars event" style="width:100%; height:100%; object-fit:cover;"></div>
      </div>
      <div class="photo-row">
        <div class="svc-photo" style="overflow:hidden;"><img src="/images/9596cbfbe0e3c18c.jpg" alt="Flux Entertainment firework-dance performer on stage" style="width:100%; height:100%; object-fit:cover;"></div>
        <div class="svc-photo" style="overflow:hidden;"><img src="/images/a4cd1becfdb8413d.jpg" alt="Flux Entertainment fire and pyrotechnics performer" style="width:100%; height:100%; object-fit:cover;"></div>
        <div class="svc-photo" style="overflow:hidden;"><img src="/images/46e12eaf360e6610.jpg" alt="Flux Entertainment duo pyrotechnics performance at a corporate event" style="width:100%; height:100%; object-fit:cover;"></div>
      </div>

      <div class="highlight-block">
        <p>Flux's firework-dance acts are widely recognised as the most high-impact performance offerings in the country, delivering unmatched energy and spectacle. We have produced some of the largest pyrotechnic performances in Australia for leading clients across live sport entertainment, live television, and major corporate and private events. With an exceptional safety record and rigorous attention to detail, our team manages all compliance and licensing requirements, allowing us to perform seamlessly in every state of Australia.</p>
      </div>

      <div class="sfx-callout">
        <p>Enhance your experience even further with <strong>Flux SFX</strong> — choreographed fireworks, flame effects, and stage effects that elevate any performance into something even more immersive.</p>
        <a href="https://www.fluxsfx.com.au" target="_blank" rel="noopener" class="btn-ghost">Explore Flux SFX</a>
      </div>
    </div>
  </section>

  <!-- TRUSTED BY -->
  <div class="trust" style="margin-top:0;">
    <div class="trust-label mono">Who We've Worked With</div>
    <div class="marquee-track">
      <div class="logo-box client"><img src="/images/057c0d093231835b.png" alt="ACT Government logo"></div>
