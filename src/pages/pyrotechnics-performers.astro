    </div>
  </div>

  <!-- CTA -->
  <section class="cta" id="contact-cta" style="background:
      linear-gradient(140deg, rgba(140,26,26,0.55), rgba(10,9,8,0.88) 65%),
      url('/images/bf0909e82ec37ae9.jpg');
      background-size:cover; background-position:center;">
    <div class="mark-bg"></div>
    <div class="wrap cta-inner">
      <span class="mono" style="color:rgba(244,237,228,0.7);">Book Now</span>
      <h2 style="margin-top:18px;">Let's Make It<br>Unforgettable.</h2>
      <p>Tell us about your event and we'll get back to you with what's possible — Australia wide.</p>
