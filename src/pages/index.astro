  <!-- SHOWREEL -->
  <section class="showreel" style="background:var(--char); padding-top:110px; padding-bottom:110px;">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:44px;">
        <span class="mono eyebrow">See Us In Action</span>
        <h2 style="margin-top:18px;">The Full Show Reel</h2>
        <p>Four minutes of Flux at full scale — fire, fireworks, and production design in front of the country's biggest crowds.</p>
      </div>
      <div id="showreelBox" style="position:relative; width:100%; aspect-ratio:16/9; background:#000; border:1px solid #2A231F; overflow:hidden;">
        <a href="https://youtu.be/AOsidJRkQEI" target="_blank" rel="noopener" id="showreelThumb" style="position:absolute; inset:0; display:block;">
          <img src="https://img.youtube.com/vi/AOsidJRkQEI/maxresdefault.jpg" alt="Flux Entertainment show reel" style="width:100%; height:100%; object-fit:cover; opacity:0.75;">
          <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center;">
            <div style="width:88px; height:88px; border-radius:50%; background:rgba(214,40,40,0.92); display:flex; align-items:center; justify-content:center; box-shadow:0 10px 40px -8px rgba(214,40,40,0.7); transition:transform 0.2s ease;">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="var(--bone)"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
          <span class="mono" style="position:absolute; bottom:20px; left:24px; color:var(--bone); background:rgba(10,9,8,0.6); padding:8px 14px;">Hover to preview — click for full video</span>
        </a>
      </div>
      <script>
        // On the live site: hovering plays the reel inline with sound;
        // moving away stops it. Click always opens the full video on YouTube.
        (function(){
          var box = document.getElementById('showreelBox');
          var thumb = document.getElementById('showreelThumb');
          var iframe = null;
          var isTouch = window.matchMedia('(hover: none)').matches;
          if (isTouch) return; // touch devices keep click-to-YouTube only
          box.addEventListener('mouseenter', function(){
            if (iframe) return;
            iframe = document.createElement('iframe');
            iframe.src = 'https://www.youtube.com/embed/AOsidJRkQEI?autoplay=1&mute=0&controls=1&rel=0';
            iframe.style.cssText = 'position:absolute; inset:0; width:100%; height:100%; border:0;';
            iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
            iframe.allowFullscreen = true;
            box.appendChild(iframe);
            thumb.style.opacity = '0';
            thumb.style.pointerEvents = 'none';
          });
          box.addEventListener('mouseleave', function(){
            if (iframe) { box.removeChild(iframe); iframe = null; }
            thumb.style.opacity = '1';
            thumb.style.pointerEvents = 'auto';
          });
        })();
      </script>
    </div>
  </section>

