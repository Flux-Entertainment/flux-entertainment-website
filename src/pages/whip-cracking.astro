      <div class="logo-box client"><img src="/images/714c7fb29e58d496.png" alt="Sony logo"></div>
      <div class="logo-box client"><img src="/images/6cfccd44252db448.png" alt="Sovereign Hill logo"></div>
      <div class="logo-box client"><img src="/images/25aef8b2bfb63d2f.png" alt="Warner Bros. Movie World logo"></div>
      <div class="logo-box client"><img src="/images/c4a2ad5d8588563f.png" alt="Village Roadshow Theme Parks logo"></div>
    </div>
  </div>

  <!-- CTA -->
  <section class="cta" id="contact-cta" style="background:
      linear-gradient(140deg, rgba(140,26,26,0.55), rgba(10,9,8,0.88) 65%),
      url('/images/780aebb9414c426e.jpg');
      background-size:cover; background-position:center;">
    <div class="mark-bg"></div>
    <div class="wrap cta-inner">
      <span class="mono" style="color:rgba(244,237,228,0.7);">Book Now</span>
      <h2 style="margin-top:18px;">Let's Make It<br>Unforgettable.</h2>
      <p>Tell us about your event and we'll get back to you with what's possible, Australia wide.</p>
      <div class="cta-actions">
        <a href="/contact" class="btn-primary">Enquire Now</a>
        <a href="tel:+61473458788" class="btn-ghost">Call, 0473 458 788</a>
      </div>
    </div>
  </section>

</main>

<script>
  (function(){
    var vid = document.getElementById('whipFeatureVideo');
    if (!vid) return;
    var observer = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting) {
          vid.play().catch(function(){});
        } else {
          vid.pause();
        }
      });
    }, { threshold: 0.4 });
    observer.observe(vid);
  })();
</script>
</Layout>
