      <div class="logo-box client"><img src="/images/4d2859ac3fe7e12c.png" alt="Australian Tattoo Expo logo"></div>
      <div class="logo-box client"><img src="/images/7283b8dbad3373d9.png" alt="V8 Supercars logo"></div>
      <div class="logo-box client"><img src="/images/ae8b5ff6752be453.png" alt="Mitre 10 logo"></div>
      <div class="logo-box client"><img src="/images/2d6a6980ad8d3164.png" alt="Paniyiri Greek Festival logo"></div>
