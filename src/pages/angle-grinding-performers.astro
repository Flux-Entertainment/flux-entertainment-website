---
import Layout from '../layouts/Layout.astro';
const title = "Angle Grinding Performers | Flux Entertainment";
const description = "Angle grinding performance acts from Flux Entertainment, sparks, power tools, and danger-edged spectacle. Solo, duo & trio acts, standalone or as show add-ons.";
---
<Layout title={title} description={description}>
  <Fragment slot="page-style">
<style is:global>
  .svc-hero{
    position:relative; min-height:60vh; padding-top:140px; padding-bottom:60px; overflow:hidden;
    background:var(--void);
  }
  .svc-hero-video{position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center top; z-index:0;}
  .svc-hero-overlay{
    position:absolute; inset:0; z-index:1;
    background:
      linear-gradient(to top, rgba(10,9,8,0.97) 0%, rgba(10,9,8,0.65) 55%, rgba(10,9,8,0.45) 100%),
      radial-gradient(ellipse 70% 60% at 75% 25%, rgba(140,26,26,0.35) 0%, rgba(10,9,8,0) 65%);
  }
  .svc-hero h1{font-size:clamp(2.6rem, 6vw, 5rem); color:var(--bone); max-width:820px;}
  .svc-breadcrumb{color:var(--ash-dim); font-size:0.82rem; margin-bottom:20px;}
  .svc-breadcrumb a{color:var(--ash-dim);}
  .svc-breadcrumb a:hover{color:var(--gold);}

  .svc-photo{
    aspect-ratio:3/4; background:
      radial-gradient(circle at 30% 20%, rgba(214,40,40,0.35), transparent 60%), var(--char-2);
    border:1px solid #2A231F;
  }
  .options-grid{display:grid; grid-template-columns:1fr; gap:0; position:relative; z-index:2; margin-top:26px; max-width:640px;}
  .option-item{display:flex; align-items:center; gap:14px; padding:14px 0; border-top:1px solid #29221E; color:var(--ash); font-size:0.98rem;}
  .option-item svg{width:18px; height:18px; color:var(--gold); flex-shrink:0;}

  .photo-row{display:grid; grid-template-columns:repeat(3,1fr); gap:20px; position:relative; z-index:2;}
  .photo-row .svc-photo{aspect-ratio:4/3;}

  .highlight-block{
    border-left:2px solid var(--flame); padding:6px 0 6px 28px; margin-top:50px;
    position:relative; z-index:2;
  }
  .highlight-block p{color:var(--ash); font-size:1.05rem; line-height:1.6;}

  .sfx-callout{
    margin-top:50px; border:1px solid #2A231F; padding:32px; display:flex; align-items:center;
    justify-content:space-between; gap:24px; flex-wrap:wrap; position:relative; z-index:2;
  }
  .sfx-callout p{color:var(--ash); max-width:560px; font-size:0.98rem;}
  .sfx-callout p strong{color:var(--bone);}

  @media (max-width:860px){
    .options-grid{grid-template-columns:1fr;}
    .photo-row{grid-template-columns:1fr 1fr;}
    .about-grid{grid-template-columns:1fr;}
  }
</style>
  </Fragment>
<main id="top">

  <!-- SERVICE HERO -->
  <section class="svc-hero">
    <video class="svc-hero-video" autoplay muted loop playsinline aria-label="Flux Entertainment angle grinding performance footage">
      <source src="https://videos.fluxentertainment.com.au/hero-v2.mp4" type="video/mp4">
    </video>
    <div class="svc-hero-overlay"></div>
    <div class="mark-bg" style="top:-150px; right:-200px; opacity:0.3; z-index:1;"></div>
    <div class="wrap" style="position:relative; z-index:2;">
      <div class="svc-breadcrumb"><a href="/">Home</a> / <a href="/#services">Entertainment</a> / Angle Grinding Performers</div>
      <span class="mono eyebrow">Entertainment</span>
      <h1 style="margin-top:18px;">Angle Grinding Performers</h1>
      <p class="hero-sub" style="margin-top:22px;">Power tools meet performance art, an unmistakably unique act that adds a thrilling, danger-edged spectacle to any event.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn-primary">Book Now</a>
      </div>
    </div>
  </section>

  <!-- STORY -->
  <section class="about" style="padding-top:70px; padding-bottom:50px;">
    <div class="mark-bg" style="top:10%; left:-350px; opacity:0.25;"></div>
    <div class="wrap about-grid">
      <div class="about-copy">
        <p>Angle grinding acts are an incredibly unique, impactful, and entertaining addition to an event, show or production. Watch our grinding performers use power tools to creatively express and produce sparks for visual appeal, plus adding a thrilling "danger-type" element to the performance.</p>
        <p>Angle grinding acts can be feature shows, additions to other Flux shows, or freestyle/roving acts, and can be booked as solo, duo and trio acts. Our performers even angle grind sparks onto each other.</p>
        <p>These performances are suitable to a wide variety of events and demographics, bringing something genuinely unforgettable to any production.</p>
        <a href="/contact" class="btn-ghost" style="display:inline-block; margin-top:10px;">Enquire About This Show</a>
      </div>
      <div class="svc-photo" style="overflow:hidden;">
        <video autoplay muted loop playsinline aria-label="Flux Entertainment angle grinding performer close-up" style="width:100%; height:100%; object-fit:cover;">
          <source src="https://videos.fluxentertainment.com.au/angle-paragraph-video.mp4" type="video/mp4">
        </video>
      </div>
    </div>
  </section>
  <!-- AVAILABLE OPTIONS -->
  <section class="provide" style="padding-top:60px; background:
      linear-gradient(to bottom, rgba(10,9,8,0.6) 0%, rgba(10,9,8,0.92) 70%, var(--void) 100%),
      url('/images/1ab50b57410b022a.jpg');
      background-size:cover; background-position:center; background-repeat:no-repeat;">
    <div class="wrap">
      <div class="section-head">
        <span class="mono eyebrow">What's Included</span>
        <h2 style="margin-top:18px;">Available Options</h2>
      </div>
      <div class="options-grid">
        <div class="option-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Angle grinding feature shows</div>
        <div class="option-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Angle grinding roving / freestyle</div>
        <div class="option-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Solo, duo &amp; trio acts available</div>
        <div class="option-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Angle grinding additions to other Flux shows</div>
      </div>
    </div>
  </section>

  <!-- PHOTO ROW -->
  <section class="services" style="padding-top:70px; padding-bottom:70px; background:
      linear-gradient(to bottom, rgba(10,9,8,0.55) 0%, rgba(23,19,16,0.9) 60%, var(--char) 100%),
      url('/images/c0d1870297f95e50.jpg');
      background-size:cover; background-position:center; background-repeat:no-repeat;">
    <div class="wrap">
      <div class="photo-row">
        <div class="svc-photo" style="overflow:hidden;"><img src="/images/e502acf41601f470.jpg" alt="Flux Entertainment angle grinding performer with sparks" style="width:100%; height:100%; object-fit:cover;"></div>
        <div class="svc-photo" style="overflow:hidden;"><img src="/images/bd95e3bff526d0e1.jpg" alt="Flux Entertainment angle grinding performer with fire crown" style="width:100%; height:100%; object-fit:cover;"></div>
        <div class="svc-photo" style="overflow:hidden;"><img src="/images/9b86be9f9a1b5957.jpg" alt="Flux Entertainment fire breather performing" style="width:100%; height:100%; object-fit:cover;"></div>
      </div>

      <div class="sfx-callout">
        <p>Enhance your experience even further with <strong>Flux SFX</strong>: choreographed fireworks, flame effects, and stage effects that elevate any performance into something even more immersive.</p>
        <a href="https://www.fluxsfx.com.au" target="_blank" rel="noopener" class="btn-ghost">Explore Flux SFX</a>
      </div>
    </div>
  </section>

  <!-- TRUSTED BY -->
